[mysqld]
# Log General
general_log = 1
log_raw = 1
general_log_file = /var/logs/mysql/mysql_general.log

# Log Error
log_error = /var/logs/mysql/mysql_error.log

# Keep MySQL's memory footprint small enough for a constrained container (avoids the
# OOM kill seen during InnoDB init). Plenty for this tiny challenge database.
performance_schema = OFF
innodb_buffer_pool_size = 64M
innodb_redo_log_capacity = 16M
